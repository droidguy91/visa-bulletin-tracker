[Unit]
Description=Visa Bulletin tracker schedule
Documentation=https://github.com/droidguy91/visa-bulletin-tracker

[Timer]
# FR-2.1: every 30 minutes during the publication window (the 5th to the
# 20th), roughly 08:00-20:00 US Eastern, plus one daily heartbeat.
# OnCalendar is local time on this machine.
OnCalendar=*-*-05..20 08..20:00/30:00
OnCalendar=*-*-* 11:00:00

# Catch up after the machine was asleep or off.
Persistent=true

# Never hit the source at the same second every run.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
